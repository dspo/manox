{
  "name": "manox-webui",
  "version": "0.4.0",
  "private": true,
  "description": "manox webui frontend — shared webview between the VS Code extension and the browser host. Zero business logic; pure rendering plus a transport-only bridge (vscode postMessage or WebSocket).",
  "type": "module",
  "scripts": {
    "build": "bash build.sh",
    "build:webview": "node esbuild.mjs && tailwindcss -i src/sidebar/webview/styles/tokens.css -o dist/webview/bundle.css --minify",
    "build:contracts": "node stage-contracts.mjs",
    "dev": "node dev-server.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "vitest": "^4.1.10"
  }
}
