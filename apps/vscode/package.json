{
  "name": "manox-vscode",
  "displayName": "manox",
  "description": "manox agent workbench inside VS Code — pi kernel via napi (apps/vscode/manox-napi), tools on the vscode API.",
  "version": "0.4.0",
  "publisher": "dspo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "enabledApiProposals": [
    "chatProvider",
    "languageModelThinkingPart"
  ],
  "keywords": [
    "language-models"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:manox.chatView",
    "onChatParticipant:manox",
    "onLanguageModelChatProvider:manox"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "manox",
        "displayName": "manox",
        "configuration": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "description": "cx provider name whose models this group exposes (matches the provider name in ~/.manox/cx.providers.config.yaml)."
            }
          }
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "manox",
        "fullName": "manox",
        "name": "manox",
        "description": "manox agent — ask anything, it runs on the native pi kernel",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "manox",
      "properties": {
        "manox.approvalMode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "enumDescriptions": [
            "Tools may read but not modify files",
            "Writes confined to the workspace and the manox state home",
            "No confinement; every tool call runs unrestricted"
          ],
          "default": "workspace-write",
          "markdownDescription": "Tool-authorization policy for manox sessions, mirroring the native `PermissionMode`. `read-only` refuses file mutations; `workspace-write` confines writes to the workspace and state home; `danger-full-access` runs every tool call without confinement."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "manox",
          "title": "manox",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "manox": [
        {
          "type": "webview",
          "id": "manox.chatView",
          "name": "manox",
          "contextualTitle": "manox"
        }
      ]
    },
    "commands": [
      {
        "command": "manox.focus",
        "title": "manox: Focus Chat"
      },
      {
        "command": "manox.newSession",
        "title": "manox: New Session",
        "icon": "$(add)"
      },
      {
        "command": "manox.openTurnNavigator",
        "title": "manox: Open User Turn Navigator"
      }
    ],
    "keybindings": [
      {
        "command": "manox.openTurnNavigator",
        "mac": "cmd+m",
        "when": "view == manox.chatView"
      },
      {
        "command": "manox.openTurnNavigator",
        "win": "ctrl+m",
        "linux": "ctrl+m",
        "when": "view == manox.chatView"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "manox.newSession",
          "when": "view == manox.chatView",
          "group": "navigation"
        }
      ]
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "precompile": "cd ../web/webui && npm run build:contracts",
    "compile": "tsc -p ./",
    "test": "vitest run",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.98.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
