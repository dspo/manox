{
  "name": "manox-vscode",
  "displayName": "manox",
  "description": "manox agent workbench inside VS Code — pi kernel via napi (crates/manox-napi), tools on the vscode API.",
  "version": "0.4.0",
  "publisher": "dspo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "enabledApiProposals": [
    "chatProvider",
    "languageModelThinkingPart"
  ],
  "keywords": [
    "language-models"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:manox.chatView",
    "onChatParticipant:manox",
    "onLanguageModelChatProvider:manox"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "manox",
        "displayName": "manox",
        "configuration": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "description": "cx provider name whose models this group exposes (matches the provider name in ~/.config/cx/cx.providers.config.yaml)."
            }
          }
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "manox",
        "fullName": "manox",
        "name": "manox",
        "description": "manox agent — ask anything, it runs on the native pi kernel",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "manox",
      "properties": {
        "manox.approvalMode": {
          "type": "string",
          "enum": [
            "danger",
            "autopilot"
          ],
          "enumDescriptions": [
            "Run every tool call without authorization prompts",
            "Gate authorization-required tool calls on the safety reviewer, escalating to an approval card when unsure"
          ],
          "default": "danger",
          "markdownDescription": "Tool-authorization policy for manox sessions. `danger` runs everything without prompting; `autopilot` routes authorization-required tool calls through the safety reviewer with user escalation."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "manox",
          "title": "manox",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "manox": [
        {
          "type": "webview",
          "id": "manox.chatView",
          "name": "manox",
          "contextualTitle": "manox"
        }
      ]
    },
    "commands": [
      {
        "command": "manox.focus",
        "title": "manox: Focus Chat"
      },
      {
        "command": "manox.newSession",
        "title": "manox: New Session",
        "icon": "$(add)"
      },
      {
        "command": "manox.openTurnNavigator",
        "title": "manox: Open User Turn Navigator"
      }
    ],
    "keybindings": [
      {
        "command": "manox.openTurnNavigator",
        "mac": "cmd+m",
        "when": "view == manox.chatView"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "manox.newSession",
          "when": "view == manox.chatView",
          "group": "navigation"
        }
      ]
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "build:webview": "node esbuild.webview.mjs && tailwindcss -i src/sidebar/webview/styles/tokens.css -o dist/webview/bundle.css --minify",
    "watch:webview": "node esbuild.webview.mjs --watch & tailwindcss -i src/sidebar/webview/styles/tokens.css -o dist/webview/bundle.css --watch",
    "compile": "tsc -p ./ && tsc -p tsconfig.webview.json",
    "test": "vitest run",
    "package": "npm run compile && npm run build:webview && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.98.0",
    "@vscode/vsce": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "vitest": "^4.1.10"
  }
}
