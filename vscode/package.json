{
  "name": "manox-vscode",
  "displayName": "manox",
  "description": "manox agent workbench inside VS Code — pi kernel via napi (crates/manox-napi), tools on the vscode API.",
  "version": "0.2.0",
  "publisher": "dspo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:manox.chatView",
    "onChatParticipant:manox"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "manox",
        "fullName": "manox",
        "name": "manox",
        "description": "manox agent — ask anything, it runs on the native pi kernel",
        "isSticky": true
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "manox",
          "title": "manox",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "manox": [
        {
          "type": "webview",
          "id": "manox.chatView",
          "name": "manox",
          "contextualTitle": "manox"
        }
      ]
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.98.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
